# Variables de entorno del proyecto.
# Copia este fichero a .env (o exporta las variables en tu shell) y ajusta los valores.

# Raíz del proyecto. Opcional: por defecto es el directorio raíz del repositorio.
# Las rutas de [paths] en config.toml se resuelven contra $SDPD2_HOME/<data_dir>.
SDPD2_HOME=/ruta/a/tripadvisor-data-pipeline

# JDK que usa Spark (fases 2 y 3). Obligatoria: los scripts no la sobrescriben
# y avisan si no está definida.
JAVA_HOME=/ruta/al/jdk-11

# Directorio de trabajo de Airflow (fase 1). El README usa la raíz del repositorio.
AIRFLOW_HOME=/ruta/a/tripadvisor-data-pipeline
